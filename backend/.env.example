# Server
PORT=5000

# Origin frontend yang boleh akses API (pisahkan dengan koma kalau lebih dari satu)
CORS_ORIGIN=http://localhost:3000

# Database MySQL / MariaDB (XAMPP: user root, password kosong)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=pasar_buku_wilis

# JWT: ganti dengan string acak yang panjang
JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-acak
JWT_EXPIRES_IN=1d

# Set false kalau sudah di-deploy, supaya orang luar tidak bisa daftar jadi admin
ALLOW_REGISTER=true
